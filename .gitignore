__pycache__/
*.pyc
.pytest_cache/
dev/logs/*.log
.DS_Store

# Rendered verification output under dev/logs is regenerable by dev/harness/*
# and runs to ~750 MB. The verifier scripts, reports and measurement JSON that
# sit beside it are kept.
dev/logs/**/*.png
dev/logs/**/*.svg
# ...and the sprite atlas, which describes an image that is not committed
# either. Regenerate both with dev/harness/sprite_sheet.py. The measurement
# JSON elsewhere under dev/logs is NOT generated output and stays tracked.
dev/logs/tiles/sprites.json

# Daly source PDFs — originals kept locally, too large for the tree.
# The single page that earned its place is committed at
# dev/reference/sources/; see dev/reference/SOURCES.md for provenance and for
# why the full volume is not worth its 128 MB.
/*.pdf
